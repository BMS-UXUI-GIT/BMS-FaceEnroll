# ก๊อปไฟล์นี้เป็น .env.local แล้วแก้ค่าตามเครื่องตัวเอง (.env.local ไม่ขึ้น git)
#   cp .env.example .env.local

# URL ของ backend (attendance-api). ไม่ตั้ง = http://localhost:8300
# VITE_API_BASE=http://localhost:8300

# 1 = ข้าม backend ใช้ login ปลอมตอน dev (ดู src/mock.ts)
# กรอกอะไรก็เข้าได้; พิมพ์ username เป็น superadmin / bmsadmin / admin / user เพื่อเลือกบทบาท
# ใช้ได้เฉพาะ `npm run dev` เท่านั้น — ตอน build โค้ดส่วนนี้ถูกตัดทิ้ง
# VITE_MOCK=1
